# 環境變數與機密
.env
.env.*
config/.env
config/.env.*
*.env
*.env.*
!.env.example
!config/.env.example

# OS 產生的隱藏暫存檔
.DS_Store
Thumbs.db

# Python 暫存檔
__pycache__/
*.pyc

# 排除每日日記與信件（個人日常紀錄，不納入 Git 追蹤）
diary/private/
diary/letters/

# 本地即時運行狀態與使用者留言板（GitHub 僅保留 .template.md 範本）
DASHBOARD.md
OWNER_NOTE.md
!DASHBOARD.template.md
!OWNER_NOTE.template.md

# 暫存影片音訊或下載緩存（關鍵幀截圖保存在 videos/assets，若需要追蹤可保留）
videos/assets/**/*.mp4
videos/assets/**/*.webm
videos/assets/**/*.m4a
videos/assets/**/*.part
